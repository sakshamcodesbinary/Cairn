# Public configuration only. Never put invitation/admin/wallet secrets in VITE_*.
# Preview is the admin portal default; use preprod for the public Level 2–4 demo.
VITE_NETWORK=preview
VITE_PREVIEW_CONTRACT_ADDRESS=
VITE_PREPROD_CONTRACT_ADDRESS=
# Optional single-address fallback for VITE_NETWORK only:
VITE_CONTRACT_ADDRESS=
# Optional indexer overrides; ensure HTTP and WS refer to the same deployment.
# VITE_PREVIEW_INDEXER_URL=https://indexer.preview.midnight.network/api/v3/graphql
# VITE_PREVIEW_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v3/graphql/ws
# VITE_PREPROD_INDEXER_URL=https://indexer.preprod.midnight.network/api/v3/graphql
# VITE_PREPROD_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v3/graphql/ws
