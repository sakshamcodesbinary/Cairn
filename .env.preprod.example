# CLI/integration tests only. The browser uses an extension, never wallet seeds.
MIDNIGHT_NETWORK=preprod
# Set exactly ONE of the next two variables in your shell:
MIDNIGHT_PREPROD_MNEMONIC=
# MIDNIGHT_PREPROD_SEED=
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# CLI deployment: independently generated cryptographically random secrets.
CAIRN_MEMBER_SECRET_HEX=
CAIRN_ADMIN_SECRET_HEX=
CAIRN_MEMBER_CLEARANCE=2
CAIRN_MINIMUM_CLEARANCE=2
CAIRN_MAX_ENTRIES=250
CAIRN_GATE_NAME=Cairn
CAIRN_PRIVATE_STORAGE_PASSWORD=
